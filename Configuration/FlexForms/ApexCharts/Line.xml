<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <options>
            <ROOT>
                <sheetTitle>Chart</sheetTitle>
                <type>array</type>
                <el>
                    <chart.line.fill>
                        <label>Fill</label>
                        <config>
                            <type>check</type>
                        </config>
                    </chart.line.fill>
                    <chart.line.stepped>
                        <label>Curve</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="0">Smooth</numIndex>
                                    <numIndex index="1">smooth</numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="0">Straight</numIndex>
                                    <numIndex index="1">straight</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="0">Stepline</numIndex>
                                    <numIndex index="1">stepline</numIndex>
                                </numIndex>
                            </items>
                            <default>0</default>
                        </config>
                    </chart.line.stepped>
                    <chart.line.stacked>
                        <label>Stacked (useful for multiple datasets)</label>
                        <config>
                            <type>check</type>
                        </config>
                    </chart.line.stacked>
                </el>
            </ROOT>
        </options>
        <legend>
            <ROOT>
                <sheetTitle>Legend</sheetTitle>
                <type>array</type>
                <el>
                    <chart.legend.active>
                        <label>Activate</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </chart.legend.active>
                    <chart.legend.position>
                        <label>Position</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="0">Top</numIndex>
                                    <numIndex index="1">top</numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="0">Left</numIndex>
                                    <numIndex index="1">left</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="0">Right</numIndex>
                                    <numIndex index="1">right</numIndex>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <numIndex index="0">Bottom</numIndex>
                                    <numIndex index="1">bottom</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </chart.legend.position>
                </el>
            </ROOT>
        </legend>
        <x-axis>
            <ROOT>
                <sheetTitle>X-Axis</sheetTitle>
                <type>array</type>
                <el>
                    <chart.axis.x.label>
                        <label>Label</label>
                        <config>
                            <type>input</type>
                            <max>30</max>
                            <size>20</size>
                        </config>
                    </chart.axis.x.label>
                    <chart.axis.x.auto>
                        <label>Automatic calculation</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </chart.axis.x.auto>
                    <chart.axis.x.min>
                        <label>Minimum</label>
                        <displayCond>FIELD:chart.axis.x.auto:REQ:false</displayCond>
                        <config>
                            <type>input</type>
                            <size>5</size>
                            <eval>int</eval>
                        </config>
                    </chart.axis.x.min>
                    <chart.axis.x.max>
                        <label>Maximum (auto calculated if value is zero)</label>
                        <displayCond>FIELD:chart.axis.x.auto:REQ:false</displayCond>
                        <config>
                            <type>input</type>
                            <size>5</size>
                            <eval>int</eval>
                        </config>
                    </chart.axis.x.max>
                </el>
            </ROOT>
        </x-axis>
        <y-axis>
            <ROOT>
                <sheetTitle>Y-Axis</sheetTitle>
                <type>array</type>
                <el>
                    <chart.axis.y.label>
                        <label>Label</label>
                        <config>
                            <type>input</type>
                            <max>30</max>
                            <size>20</size>
                        </config>
                    </chart.axis.y.label>
                    <chart.axis.y.auto>
                        <label>Automatic calculation</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </chart.axis.y.auto>
                    <chart.axis.y.min>
                        <label>Minimum</label>
                        <displayCond>FIELD:chart.axis.y.auto:REQ:false</displayCond>
                        <config>
                            <type>input</type>
                            <size>5</size>
                            <eval>int</eval>
                        </config>
                    </chart.axis.y.min>
                    <chart.axis.y.max>
                        <label>Maximum (auto calculated if value is zero)</label>
                        <displayCond>FIELD:chart.axis.y.auto:REQ:false</displayCond>
                        <config>
                            <type>input</type>
                            <size>5</size>
                            <eval>int</eval>
                        </config>
                    </chart.axis.y.max>
                </el>
            </ROOT>
        </y-axis>
    </sheets>
</T3DataStructure>
